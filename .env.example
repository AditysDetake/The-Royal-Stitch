# ================================================================
#  THE ROYAL STITCH — Environment Configuration (.env.example)
# ================================================================

# Server Port
PORT=3000

# MongoDB Atlas Connection URI
# Obtain this from: MongoDB Atlas > Database > Connect > Drivers > Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/royalstitch?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/royalstitch?retryWrites=true&w=majority

# Admin Credentials (used to seed default admin on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Session Encryption Key
SESSION_SECRET=tailor_royal_stitch_secret_2026_super_secure

